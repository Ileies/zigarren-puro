{
	"name": "zigarren-puro",
	"private": true,
	"version": "0.0.1",
	"homepage": "https://zigarren-puro.de",
	"type": "module",
	"scripts": {
		"dev": "bun run --bun vite dev",
		"build": "bun run --bun vite build",
		"preview": "bun run --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"deploy": "bun run scripts/deploy.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"ui:add": "bun x shadcn-svelte@1.7.1 add",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "bun test",
		"db:push": "drizzle-kit push",
		"db:seed": "bun scripts/seed.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/manrope": "^5.3.0",
		"@fontsource/fira-mono": "^5.2.7",
		"@fontsource/inter": "^5.2.8",
		"@fontsource/playfair-display": "^5.2.8",
		"@fontsource/source-serif-pro": "^5.2.5",
		"@internationalized/date": "^3.12.0",
		"@neoconfetti/svelte": "^2.2.2",
		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.3.13",
		"@types/node": "^25.6.2",
		"@types/nodemailer": "^8.0.0",
		"bits-ui": "^2.20.0",
		"clsx": "^2.1.1",
		"daisyui": "^5.5.19",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"nodemailer": "^8.0.7",
		"posthog-js": "^1.372.10",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript-eslint": "^8.59.2",
		"vite": "^8.0.12",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@icons-pack/svelte-simple-icons": "^7.2.0",
		"@lucide/svelte": "^1.16.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
